<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="714.0" prefWidth="818.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.darion.app.controller.TranslatorController">
   <children>
      <HBox alignment="CENTER" layoutY="-2.0" prefHeight="639.0" prefWidth="818.0">
         <children>
            <VBox alignment="CENTER" prefHeight="714.0" prefWidth="214.0">
               <children>
                  <Label fx:id="leftLabel" text="Cyrillic">
                     <VBox.margin>
                        <Insets bottom="10.0" />
                     </VBox.margin>
                     <font>
                        <Font size="22.0" />
                     </font>
                  </Label>
                  <TextArea fx:id="leftTextArea" prefHeight="335.0" prefWidth="214.0" wrapText="true">
                     <opaqueInsets>
                        <Insets />
                     </opaqueInsets>
                     <font>
                        <Font size="15.0" />
                     </font>
                  </TextArea>
                  <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                     <opaqueInsets>
                        <Insets top="22.0" />
                     </opaqueInsets>
                     <cursor>
                        <Cursor fx:constant="DEFAULT" />
                     </cursor>
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                     <children>
                        <Button fx:id="clearButton" mnemonicParsing="false" onAction="#onClear" prefHeight="45.0" prefWidth="150.0" text="Clear">
                           <font>
                              <Font size="21.0" />
                           </font>
                        </Button>
                     </children>
                  </HBox>
                  <Label>
                     <font>
                        <Font size="15.0" />
                     </font>
                  </Label>
               </children>
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
            </VBox>
            <VBox alignment="CENTER" prefHeight="568.0" prefWidth="215.0">
               <children>
                  <Button fx:id="switchModeButton" focusTraversable="false" mnemonicParsing="false" onAction="#onSwitchMode" prefHeight="56.0" prefWidth="107.0" text="Switch">
                     <font>
                        <Font size="18.0" />
                     </font>
                     <VBox.margin>
                        <Insets bottom="70.0" />
                     </VBox.margin>
                  </Button>
               </children>
            </VBox>
            <VBox alignment="CENTER" prefHeight="568.0" prefWidth="214.0">
               <children>
                  <Label fx:id="rightLabel" text="Latin">
                     <VBox.margin>
                        <Insets bottom="10.0" />
                     </VBox.margin>
                     <font>
                        <Font size="22.0" />
                     </font>
                  </Label>
                  <TextArea fx:id="rightTextArea" editable="false" prefHeight="335.0" prefWidth="158.0" wrapText="true">
                     <font>
                        <Font size="15.0" />
                     </font>
                  </TextArea>
                  <HBox alignment="CENTER" prefHeight="100.0" prefWidth="214.0">
                     <children>
                        <Button fx:id="copyButton" mnemonicParsing="false" onAction="#onCopy" prefHeight="45.0" prefWidth="150.0" text="Copy">
                           <font>
                              <Font size="21.0" />
                           </font>
                        </Button>
                     </children>
                  </HBox>
                  <Label fx:id="copiedLabel" text="Copied!" textFill="#29bc00" visible="false">
                     <font>
                        <Font size="15.0" />
                     </font>
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                  </Label>
               </children>
            </VBox>
         </children>
      </HBox>
      <HBox alignment="CENTER" layoutY="614.0" prefHeight="100.0" prefWidth="818.0">
         <children>
            <Button disable="true" mnemonicParsing="false" onAction="#onNextScene" prefHeight="47.0" prefWidth="52.0" text="❮" visible="false">
               <font>
                  <Font size="20.0" />
               </font>
            </Button>
            <Button fx:id="nextButton" focusTraversable="false" mnemonicParsing="false" onAction="#onNextScene" prefHeight="47.0" prefWidth="52.0" text="❯">
               <HBox.margin>
                  <Insets bottom="1.0" left="540.0" />
               </HBox.margin>
               <font>
                  <Font size="20.0" />
               </font>
            </Button>
         </children>
      </HBox>
   </children>
</AnchorPane>
