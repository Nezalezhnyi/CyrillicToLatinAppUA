<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="714.0" prefWidth="818.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.darion.app.controller.FileController">
   <children>
      <HBox alignment="CENTER" layoutY="25.0" prefHeight="235.0" prefWidth="818.0">
         <children>
            <Button fx:id="chooseFilesButton" mnemonicParsing="false" onAction="#onChooseFiles" prefHeight="52.0" prefWidth="151.0" text="Choose files">
               <font>
                  <Font size="19.0" />
               </font>
               <HBox.margin>
                  <Insets right="70.0" />
               </HBox.margin>
            </Button>
            <TextArea fx:id="filesTextArea" editable="false" prefHeight="235.0" prefWidth="481.0" promptText="Choose one file or more" wrapText="true">
               <font>
                  <Font size="18.0" />
               </font>
            </TextArea>
         </children>
      </HBox>
      <HBox alignment="CENTER" layoutY="305.0" prefHeight="144.0" prefWidth="818.0">
         <children>
            <VBox alignment="CENTER" prefHeight="144.0" prefWidth="256.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#onTransliterateChosenFiles" text="Transliterate chosen files">
                     <font>
                        <Font size="21.0" />
                     </font>
                     <VBox.margin>
                        <Insets top="20.0" />
                     </VBox.margin>
                  </Button>
                  <Label fx:id="chosenFilesSuccessLabel" text="Success!" textFill="#019409" visible="false">
                     <font>
                        <Font size="18.0" />
                     </font>
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </Label>
               </children>
               <HBox.margin>
                  <Insets right="272.0" top="5.0" />
               </HBox.margin>
            </VBox>
            <VBox alignment="CENTER" prefHeight="144.0" prefWidth="177.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#onCreateNewFiles" text="Create new files">
                     <font>
                        <Font size="21.0" />
                     </font>
                     <VBox.margin>
                        <Insets top="20.0" />
                     </VBox.margin>
                  </Button>
                  <Label fx:id="newFilesSuccessLabel" text="Success!" textFill="#019409" visible="false">
                     <font>
                        <Font size="18.0" />
                     </font>
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </Label>
               </children>
               <HBox.margin>
                  <Insets top="5.0" />
               </HBox.margin>
            </VBox>
         </children>
      </HBox>
      <HBox alignment="CENTER" layoutY="476.0" prefHeight="100.0" prefWidth="818.0">
         <children>
            <VBox alignment="CENTER" prefHeight="100.0" prefWidth="219.0">
               <children>
                  <HBox alignment="TOP_CENTER" prefHeight="30.0" prefWidth="219.0">
                     <children>
                        <Label fx:id="leftLabel" text="Cyrillic">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </Label>
                        <Label fx:id="arrowLabel" text="→">
                           <font>
                              <Font size="18.0" />
                           </font>
                           <HBox.margin>
                              <Insets left="10.0" right="10.0" />
                           </HBox.margin>
                        </Label>
                        <Label fx:id="rightLabel" text="Latin">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </Label>
                     </children>
                     <VBox.margin>
                        <Insets bottom="5.0" />
                     </VBox.margin>
                  </HBox>
                  <Button fx:id="switchDirectionButton" focusTraversable="false" mnemonicParsing="false" onAction="#onChangeDirection" text="Change direction">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Button>
               </children>
            </VBox>
         </children>
      </HBox>
      <HBox alignment="CENTER" layoutY="614.0" prefHeight="100.0" prefWidth="818.0">
         <children>
            <Button mnemonicParsing="false" onAction="#onPreviousScene" prefHeight="47.0" prefWidth="52.0" text="❮">
               <font>
                  <Font size="20.0" />
               </font>
            </Button>
            <Button fx:id="nextButton" focusTraversable="false" mnemonicParsing="false" onAction="#onNextScene" prefHeight="47.0" prefWidth="52.0" text="❯">
               <HBox.margin>
                  <Insets bottom="1.0" left="540.0" />
               </HBox.margin>
               <font>
                  <Font size="20.0" />
               </font>
            </Button>
         </children>
      </HBox>
   </children>
</AnchorPane>
